{
  "manifest_version": 3,
  "name": "句子库 · 划词收藏",
  "version": "1.1.0",
  "description": "在网页上划选文字，右键「收藏这句」，存进自己的句子库；可选匹配 sb6657 梗库并显示梗 id、热度与标签。",
  "browser_specific_settings": {
    "gecko": {
      "id": "sentence-saver@local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "menus", "activeTab"],
  "optional_host_permissions": ["https://sb6657.cn/*"],
  "background": {
    "scripts": ["lib/store.js", "lib/memes.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://sb6657.cn/*"],
      "js": ["content/sb6657.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "句子库",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
